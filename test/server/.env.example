# Salin jadi .env, lalu sesuaikan. JANGAN commit .env yang sudah berisi
# secret sungguhan.
#
# Jalankan server dengan:
#   node --env-file=.env index.js
# atau (PowerShell):
#   $env:JWT_SECRET = "..."; node index.js

# WAJIB (B1). Tanpa nilai ini server berhenti saat start.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-random-64-karakter

# Umur token yang dikembalikan /auth/login. Format seperti jsonwebtoken: 7d, 12h, 30m.
TOKEN_TTL=7d

# Port HTTP server.
PORT=3000

# Jumlah hop proxy yang boleh dipercaya sebelum IP dibaca dari X-Forwarded-For.
# 0 (default) = server dibuka langsung ke internet; header X-Forwarded-For
#     diabaikan supaya tidak bisa dipakai untuk menghindari rate limit.
# 1 = ada satu reverse proxy (Nginx/Cloudflare) yang memasang ulang
#     X-Forwarded-For di depan server.
TRUST_PROXY_HOPS=0

# Batas percobaan login + registrasi per IP.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MS=900000

# Lokasi file SQLite. Default: server/data/app.db
# DB_PATH=./data/app.db

# Saat produksi, server=https... harus lewat reverse proxy yang mengakhiri TLS.
NODE_ENV=development
